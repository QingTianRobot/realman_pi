<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sensor_bringup</name>
  <version>1.0.0</version>
  <description>Unified launch files to bring up the RealSense and Orbbec cameras together.</description>

  <maintainer email="maintainer@example.com">sensor_maintainer</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>python3-yaml</exec_depend>

  <!-- 注意: realsense2_camera 和 orbbec_camera 位于独立工作区/子模块
       (src/sensor/realsense/realsense_ws 和 src/sensor/OrbbecSDK_ROS2)，
       不在此声明 exec_depend，避免 colcon 交叉检查。
       realsense2_camera 依赖 librealsense2；realsense_ws 子模块初始化并 colcon
       构建后，由 rm65_camera_ros2 / start_sensors.sh source 其 install/setup.sh
       提供 ROS2 节点出图。缺少该 overlay 时 rm65_camera_ros2 自动降级
       use_realsense:=false，三路 Orbbec 仍正常启动。 -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
