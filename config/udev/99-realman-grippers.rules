# Bind the two CH340 RS-485 adapters by their physical USB topology.
# These paths are specific to the production host's powered USB hub:
#   1-3.1 -> right gripper
#   1-3.3 -> left gripper
# The adapters have no USB serial number, so /dev/ttyUSB* is not stable.
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", KERNELS=="1-3.1", SYMLINK+="realman/gripper_right", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", KERNELS=="1-3.3", SYMLINK+="realman/gripper_left", GROUP="dialout", MODE="0660"
