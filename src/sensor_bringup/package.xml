<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sensor_bringup</name>
  <version>1.0.0</version>
  <description>Unified launch files to bring up the RealSense and Orbbec cameras together.</description>

  <maintainer email="maintainer@example.com">sensor_maintainer</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>python3-yaml</exec_depend>

  <!-- 注意: realsense2_camera 和 orbbec_camera 位于独立工作区
       (src/sensor/realsense_ws 和 src/sensor/OrbbecSDK_ROS2)，
       不在此声明 exec_depend，避免 colcon 交叉检查。
       运行时通过 start_sensors.sh 同时 source 三个工作区提供。 -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
