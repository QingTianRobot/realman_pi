# Docker Compose automatically loads this file when commands run from the
# repository root. Keep the file free of private keys and tokens.
# Values passed explicitly in the shell take precedence over this file.

# ------------------------------
# Docker/ROS build mirrors
# ------------------------------
# ROS_BASE_IMAGE 候选：国内代理 docker.m.daocloud.io/library/ros:humble-ros-base；官方 ros:humble-ros-base；内部 registry 镜像。
ROS_BASE_IMAGE=docker.m.daocloud.io/library/ros:humble-ros-base
# UBUNTU_APT_MIRROR 候选：阿里云 https://mirrors.aliyun.com/ubuntu；官方 https://archive.ubuntu.com/ubuntu；内网 Ubuntu 镜像。
UBUNTU_APT_MIRROR=https://mirrors.aliyun.com/ubuntu
# UBUNTU_PORTS_APT_MIRROR 候选：阿里云 https://mirrors.aliyun.com/ubuntu-ports；官方 http://ports.ubuntu.com/ubuntu-ports；内网 arm64 镜像。
UBUNTU_PORTS_APT_MIRROR=https://mirrors.aliyun.com/ubuntu-ports
# ROS2_APT_MIRROR 候选：清华 https://mirrors.tuna.tsinghua.edu.cn/ros2/ubuntu；官方 http://packages.ros.org/ros2/ubuntu；内网 ROS 2 镜像。
ROS2_APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/ros2/ubuntu
# PYPI_INDEX_URL 候选：清华 https://pypi.tuna.tsinghua.edu.cn/simple；官方 https://pypi.org/simple；内网 PyPI simple 仓库。
PYPI_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# ------------------------------
# ROS runtime and model selection
# ------------------------------
# ROS_DOMAIN_ID 候选：0-232 的整数；本项目默认 65，远程 RViz 示例使用 166。通信两端必须相同。
ROS_DOMAIN_ID=65
# RM65_MODEL 候选：RM65-B；RM65-B-V；RM65-6F；RM65-6FB；RM65-6FB-V。
RM65_MODEL=RM65-B
# RM65_USE_GUI 候选：false（无 GUI 假关节状态）；true（启动 joint_state_publisher_gui）。
RM65_USE_GUI=false
# RM65_USE_RVIZ 候选：true（启动 RViz 2）；false（无图形界面的 headless bringup）。
RM65_USE_RVIZ=true
# REALMAN_JOY_DEVICE 候选：auto（自动扫描）；/dev/input/eventX；/dev/input/by-id/...；glob 路径。
REALMAN_JOY_DEVICE=auto
# REALMAN_START_ROBOTS 候选：true（启动 l/m/r 描述和 TF）；false（只启动其他选项）。
REALMAN_START_ROBOTS=true
# REALMAN_START_DRIVER 候选：true（连接三台真实机械臂）；false（仅启动描述/TF 或测试输入）。
REALMAN_START_DRIVER=false
# REALMAN_START_JOY_DRIVER 候选：true（启动 SDL Joy）；false（不读取手柄）。
REALMAN_START_JOY_DRIVER=false
# REALMAN_START_CONTROLLER 候选：true（启动 Xbox 按键处理）；false（不启动输入处理节点）。
REALMAN_START_CONTROLLER=false
# REALMAN_USE_GUI 候选：true（启动关节状态 GUI）；false（不启动 GUI）。
REALMAN_USE_GUI=false
# REALMAN_USE_RVIZ 候选：true（启动三臂 RViz）；false（headless，默认更安全）。
REALMAN_USE_RVIZ=false
# REALMAN_WAIT_FOR_JOY_DEVICE 候选：true（设备出现前持续等待）；false（设备不存在时不等待）。
REALMAN_WAIT_FOR_JOY_DEVICE=false
# REALMAN_JOY_POLL_INTERVAL 候选：0.1-60.0 秒之间的正数；默认 1.0。
REALMAN_JOY_POLL_INTERVAL=1.0
# REALMAN_DRIVER_CONFIG_FILE 候选：/opt/rm65_ws/config/ros/realman_driver.yaml；mock 配置路径；内部挂载配置路径。
REALMAN_DRIVER_CONFIG_FILE=/opt/rm65_ws/config/ros/realman_driver.yaml
# REALMAN_COORDINATES_CONFIG_FILE 候选：/opt/rm65_ws/config/ros/realman_coordinates.yaml；内部坐标配置路径。
REALMAN_COORDINATES_CONFIG_FILE=/opt/rm65_ws/config/ros/realman_coordinates.yaml
# REALMAN_MOTION_CONFIG_FILE 候选：/opt/rm65_ws/config/ros/realman_motion.yaml；内部运动安全配置路径。
REALMAN_MOTION_CONFIG_FILE=/opt/rm65_ws/config/ros/realman_motion.yaml
# REALMAN_WEB_CONTROL_CONFIG_FILE 候选：/opt/rm65_ws/config/ros/realman_web_control.yaml；内部 Web 配置路径。
REALMAN_WEB_CONTROL_CONFIG_FILE=/opt/rm65_ws/config/ros/realman_web_control.yaml
# REALMAN_START_WEB_CONTROL 候选：false（不随 bringup 启动）；true（在同一 bringup 中启动 Web 控制）。
REALMAN_START_WEB_CONTROL=false

# ------------------------------
# RViz/X11 host integration
# ------------------------------
# DISPLAY 候选：:0；:1；留空则沿用宿主环境或由函数设置。
DISPLAY=
# XAUTHORITY 候选：$HOME/.Xauthority；$XDG_RUNTIME_DIR/.mutter-Xwaylandauth.*；留空则使用 Compose 的 /dev/null 默认值。
XAUTHORITY=
# LIBGL_ALWAYS_SOFTWARE 候选：1（兼容性优先）；0（使用硬件 OpenGL，需匹配宿主驱动）。
LIBGL_ALWAYS_SOFTWARE=1

# ------------------------------
# Web control authorization
# ------------------------------
# REALMAN_WEB_CONTROL_TOKEN 候选：留空=只读；生产环境=使用 `openssl rand -hex 32` 生成的长随机字符串；不要提交真实 token。
REALMAN_WEB_CONTROL_TOKEN=
